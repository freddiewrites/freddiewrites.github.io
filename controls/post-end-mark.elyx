import "tokens/colors.elyx" as colorTokens
import "tokens/lengths.elyx" as lengthTokens

// The small plum square that ends a post, centered with 48px above and below.
export postEndMark = frame {
  left: 0px,
  top: 0px,
  width: 636px,
  height: .auto,
  layout: {direction: .column, align-items: .center},
  padding: [lengthTokens.spacing.space-xl, 0px],
  children: mark,

  mark = frame {
    width: 8px,
    height: 8px,
    fill: colorTokens.colors.link-color
  }
}
