import "tokens/colors.elyx" as colorTokens
import "tokens/lengths.elyx" as lengthTokens
import "tokens/typography.elyx" as typeTokens
import "controls/text-styles.elyx" as textStyles

// A bulleted list item. The plum marker hangs in the 24px list indent.
// itemContent is a slot: swap itemText for a plain text layer when the item needs inline styles.
export listItem = frame {
  left: 0px,
  top: 0px,
  width: 400px,
  height: .auto,
  layout: {direction: .column},
  overflow: .visible,
  padding-left: lengthTokens.spacing.space-md,
  children: [itemMarker, itemContent],

  itemMarker = text {
    left: 0px,
    top: 0px,
    width: 18px,
    ignore-stack: .true,
    fill: colorTokens.colors.link-color,
    contents: "•",
    font-size: typeTokens.fontSizes.body,
    font-family: typeTokens.fonts.font-body,
    line-height: typeTokens.lineHeights.body,
    font-features: .lining-figures,
    align: .right
  }

  itemContent = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: lengthTokens.spacing.space-xs},
    slot: .true,
    children: itemText,

    itemText = text : textStyles.paragraph {
      width: 100%,
      contents: "List item"
    }
  }
}

// An ordered list item; set the marker's number on each instance.
@variant
export numberedListItem = frame : listItem {
  left: 0px,
  top: 48px,

  itemMarker {
    contents: "1."
  }
}
