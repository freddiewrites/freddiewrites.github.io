import "tokens/colors.elyx" as colorTokens
import "tokens/lengths.elyx" as lengthTokens
import "resources/icons/fh-logo.svg" as fhLogo
import "controls/nav-link.elyx" as navLinks

// The site header from _includes/header.html: the FH marque and the main nav.
// Spacing and logo size come from tokens, so phones need no separate layout.
export siteHeader = frame {
  width: lengthTokens.sizes.frame-width,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center},
  padding: [lengthTokens.spacing.space-md, lengthTokens.insets.frame-padding],
  children: [siteLogo, navGroup],

  siteLogo = asset {
    width: lengthTokens.sizes.logo-size,
    height: lengthTokens.sizes.logo-size,
    fill: colorTokens.colors.text-color,
    contents: fhLogo
  }

  navGroup = frame {
    width: .auto,
    height: .auto,
    layout: {align-items: .center, item-gap: lengthTokens.insets.nav-gap},
    overflow: .visible,
    children: [aboutLink, nowLink, postsLink],

    aboutLink = frame : navLinks.navLink {
      linkLabel {
        contents: "About"
      }
    }

    nowLink = frame : navLinks.navLink {
      linkLabel {
        contents: "Now"
      }
    }

    postsLink = frame : navLinks.navLink {}
  }
}
