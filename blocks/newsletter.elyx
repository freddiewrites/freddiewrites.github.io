import "tokens/colors.elyx" as colorTokens
import "tokens/lengths.elyx" as lengthTokens
import "tokens/typography.elyx" as typeTokens
import "controls/text-field.elyx" as fields
import "controls/button.elyx" as buttons
import "controls/text-styles.elyx" as textStyles

// The signup fields from _includes/newsletter-fields.html, in one row as on screens 600px and wider.
export newsletterForm = frame {
  left: 0px,
  top: 0px,
  width: 570px,
  height: .auto,
  layout: {align-items: .end, item-gap: lengthTokens.spacing.space-sm},
  children: [firstNameField, emailField, subscribeButton],

  firstNameField = frame : fields.textField {
    width: 177px,

    fieldLabel {
      contents: "First name"
    }
  }

  emailField = frame : fields.textField {
    width: 249px
  }

  subscribeButton = frame : buttons.button {}
}

// Below 600px the fields stack at full width and the button sits under them.
@context(media="mobile")
export mobileNewsletterForm = frame : newsletterForm {
  left: 0px,
  top: 120px,
  width: 294px,
  layout.align-items: .start,
  layout.direction: .column,

  firstNameField {
    width: 100%
  }

  emailField {
    width: 100%
  }
}

// The homepage signup panel from _includes/newsletter-form.html.
export newsletterPanel = frame {
  left: 640px,
  top: 0px,
  width: 636px,
  height: .auto,
  layout: {direction: .column},
  fill: colorTokens.colors.code-bg,
  border: colorTokens.colors.border-color,
  corner-radius: lengthTokens.radii.radius-panel,
  padding: lengthTokens.insets.panel-padding,
  children: [titleWrap, blurb, form],

  titleWrap = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column},
    overflow: .visible,
    padding-bottom: lengthTokens.spacing.space-xs,
    children: [accentBar, newsletterTitle],

    // The plum bar runs from the panel's outer edge (padding + 1px border), as tall as the heading.
    accentBar = frame {
      left: -33px,
      top: 3px,
      bottom: 11px,
      width: 5px,
      ignore-stack: .true,
      fill: colorTokens.colors.link-color
    }

    newsletterTitle = text : textStyles.heading3 {
      width: 100%,
      contents: "From the desk of Freddie Harrison",
      font-size: typeTokens.fontSizes.title-lg
    }
  }

  blurb = text : textStyles.mutedParagraph {
    width: 100%,
    contents: "Get an occasional email of things I’ve been reading, watching, thinking and discovering. No tracking. Unsubscribe anytime."
  }

  form = frame : newsletterForm {
    width: 100%,
    padding-top: lengthTokens.spacing.space-md
  }
}

// On phones the panel has 24px padding and the stacked form.
@context(media="mobile")
export mobileNewsletterPanel = frame : newsletterPanel {
  left: 0px,
  top: 460px,
  width: 358px,

  @with-variant(mobileNewsletterForm)
  form {}

  titleWrap {
    accentBar {
      left: -25px
    }
  }
}
