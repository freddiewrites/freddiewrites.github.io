import "tokens/lengths.elyx" as lengthTokens
import "tokens/typography.elyx" as typeTokens
import "tokens/colors.elyx" as colorTokens
import "blocks/page-layout.elyx" as layouts
import "blocks/site-footer.elyx" as footer
import "blocks/latest-posts.elyx" as latest
import "blocks/newsletter.elyx" as newsletter
import "controls/divider.elyx" as dividers

@with-context()
__file__

// The homepage (_layouts/home.html and index.markdown).
// Four boards: desktop light, desktop dark, mobile light and mobile dark.
export home = frame : layouts.pageLayout {
  left: 0px,
  top: 0px,

  main {
    overrides: [
      insert(intro, after = .nil),
      insert(topDivider, after = intro),
      insert(latestSection, after = topDivider),
      insert(bottomDivider, after = latestSection),
      insert(newsletterPanel, after = bottomDivider)
    ]
  }

  intro = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: lengthTokens.spacing.space-md},
    padding-top: lengthTokens.spacing.space-md,
    children: [masthead, introText],

    // Inline link styles need a plain text layer; subranges don't apply on text instances.
    masthead = text {
      width: 100%,
      fill: colorTokens.colors.text-color,
      subrange: [
        {range: [6, 8], font-family: "Apple Color Emoji"},
        {
          range: [90, 94],
          underline: .single,
          fill: colorTokens.colors.link-color
        },
        {
          range: [99, 105],
          underline: .single,
          fill: colorTokens.colors.link-color
        }
      ],
      contents: "Hello 👋 I’m Freddie Harrison. I’m a writer and accidental marketer, currently working on Elyx and Sketch.",
      font-size: typeTokens.fontSizes.masthead,
      font-family: typeTokens.fonts.font-body,
      line-height: typeTokens.lineHeights.masthead,
      letter-spacing: -1.2%
    }

    introText = text {
      width: 100%,
      fill: colorTokens.colors.text-color,
      subrange: [
        {
          range: [78, 96],
          underline: .single,
          fill: colorTokens.colors.link-color
        },
        {
          range: [110, 128],
          underline: .single,
          fill: colorTokens.colors.link-color
        }
      ],
      contents: "Here, I write about what I’ve been thinking, seeing and reading. You can also read more about me and find out what I’m doing now, if that’s your thing.",
      font-size: typeTokens.fontSizes.intro,
      font-family: typeTokens.fonts.font-body,
      line-height: typeTokens.lineHeights.body,
      font-features: .oldstyle-figures
    }
  }

  topDivider = frame : dividers.divider {
    width: 100%
  }

  latestSection = frame : latest.latestPosts {
    width: 100%
  }

  bottomDivider = frame : dividers.divider {
    width: 100%
  }

  newsletterPanel = frame : newsletter.newsletterPanel {
    width: 100%
  }
}

@context(theme="dark")
homeDark = frame : home {
  left: 1124px,
  top: 0px
}

@context(media="mobile")
homeMobile = frame : home {
  left: 2248px,
  top: 0px,
  width: 390px,

  @with-variant(footer.mobileSiteFooter)
  siteFooter {
    left: .nil,
    top: .nil
  }

  main {
    @with-variant(newsletter.mobileNewsletterPanel)
    newsletterPanel {}
  }
}

@context(media="mobile", theme="dark")
homeMobileDark = frame : homeMobile {
  left: 2738px,
  top: 0px,
  width: 390px
}
